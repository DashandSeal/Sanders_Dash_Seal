#!/bin/bash
set -Eeuo pipefail
if [[ "$EUID" != 0 ]]; then exec sudo -n /usr/local/sbin/sanders-install-from-bucket 0be92167e082a08940bcd1e2826141f169f25e98; fi
install -d -m 0700 /etc/sanders-dash-seal
printf '%s' '' | base64 -d > /usr/local/sbin/sds-install-application
chmod 0700 /usr/local/sbin/sds-install-application
printf '%s' '' | base64 -d > /usr/local/sbin/sds-fetch-release
chmod 0700 /usr/local/sbin/sds-fetch-release
printf '%s' '${release_config_base64}' | base64 -d > /etc/sanders-dash-seal/release.json
chmod 0600 /etc/sanders-dash-seal/release.json
exec /bin/bash /usr/local/sbin/sds-install-application

version: '3.8'

services:
  # 🌐 Hardened Reverse Proxy Firewall Layer
  nginx-edge:
    image: nginx:1.25-alpine
    container_name: sds_nginx_edge
    restart: always
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro
    network_mode: "host" # Shares local loopback interface for near-zero network routing lag
    depends_on:
      - wsgi-core

  # 💎 High-Throughput Hardened WSGI Platform Core
  wsgi-core:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: sds_wsgi_core
    restart: always
    environment:
      - PYTHONUNBUFFERED=1
      - PYTHONDONTWRITEBYTECODE=1
      - STRIPE_WEBHOOK_SECRET=whsec_your_live_production_key_here
    volumes:
      - sds-ledger-volume:/app/data
    ports:
      - "127.0.0.1:8000:8000" # Explicitly maps only to local loopback

volumes:
  sds-ledger-volume:
    name: sds_production_ledger_data

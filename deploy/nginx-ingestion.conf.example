# Optional include INSIDE the existing HTTPS server block, only after the
# ingestion profile has started and independent Python runtime bindings verify.
# Do not replace nginx.conf. Alias WebSocket upgrades are denied by the worker.
location = /ingest {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 75s;
    proxy_send_timeout 10s;
    proxy_buffering off;
    access_log off;
}

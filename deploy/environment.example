# Sanders Dash & Seal runtime environment — TEMPLATE, ALL KEYS UNSET.
# Installed by install-simultaneous.sh to /etc/sanders-dash-seal/environment
# (mode 0600, root:sanders) ONLY if that file does not already exist.
# The owner fills in real values; nothing in this file is a real secret.
# Empty = disabled, and the app answers honestly instead of pretending:
#   STRIPE_WEBHOOK_SECRET empty -> webhook answers 503 webhook_gateway_disabled
#   ANTHROPIC_API_KEY / DAEDALUS_CLAUDE_MODEL empty -> Daedalus build_engine
#     raises ValueError; /api/daedalus/describe reports fully_active=false
#   Voice transcribe/speak with no provider -> 503 (voice_api)
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVEMODE=false
ANTHROPIC_API_KEY=
DAEDALUS_CLAUDE_MODEL=
DAEDALUS_TIMEOUT_SECONDS=45

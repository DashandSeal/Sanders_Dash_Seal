# Host Nginx server blocks. Install only after real certificates are provisioned.
# Do not replace the entire host nginx.conf with this include file.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name sandersdashandseal.com www.sandersdashandseal.com sanderslegalhelpersllc.com www.sanderslegalhelpersllc.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 308 https://sandersdashandseal.com/; }
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}
server {
    listen 443 ssl;
    server_name sandersdashandseal.com www.sandersdashandseal.com sanderslegalhelpersllc.com www.sanderslegalhelpersllc.com;
    # One genuine certificate must cover all four names; host-managed renewal.
    ssl_certificate /etc/letsencrypt/live/sandersdashandseal.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sandersdashandseal.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
    }
}

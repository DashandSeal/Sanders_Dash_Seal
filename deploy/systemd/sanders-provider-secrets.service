[Unit]
Description=Sanders Dash & Seal designated Oracle Vault provider secret refresh
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sanders-dash-seal
ExecStart=/usr/bin/python3 /opt/sanders-dash-seal/deploy/refresh_provider_secrets.py --restart
UMask=0077
TimeoutStartSec=5min

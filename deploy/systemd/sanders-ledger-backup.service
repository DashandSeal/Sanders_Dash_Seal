[Unit]
Description=Sanders Dash & Seal verified private ledger backup
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sanders-dash-seal
ExecStart=/usr/bin/python3 /opt/sanders-dash-seal/deploy/bind_free_resources.py --backup
UMask=0077
TimeoutStartSec=30min

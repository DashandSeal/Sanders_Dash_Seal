[Unit]
Description=Sanders Dash & Seal provisioned resource verification and heartbeat
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sanders-dash-seal
ExecStart=/usr/bin/python3 /opt/sanders-dash-seal/deploy/bind_free_resources.py
UMask=0077
TimeoutStartSec=5min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sanders-dash-seal

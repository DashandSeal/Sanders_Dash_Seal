# Region / hosting configuration for Sanders Dash & Seal (example only).
# Copy to your deployment environment and fill in real values.
# No secrets belong in this file. Nothing here provisions or deploys
# anything; see docs/global-regions-20261113.md for the plan.
#
# Verified deployed state (2026-11-13): tenancy rooseveltsanders381,
# primary region us-phoenix-1, one Always Free instance sanders-dash-seal.
# No secondary region is provisioned. Do not point these variables at a
# secondary region until it exists.

# Tenancy NAME (not OCID). Default: rooseveltsanders381.
OCI_TENANCY=rooseveltsanders381

# Primary region. Default: us-phoenix-1. Must name a DEPLOYED region.
PRIMARY_REGION=us-phoenix-1

# Region this process runs in. Default: PRIMARY_REGION.
# Must name a DEPLOYED region; us-ashburn-1 / us-chicago-1 are
# documented candidates only (NOT_PROVISIONED) and are rejected here.
OCI_REGION=us-phoenix-1

# Primary instance public IPv4, used only to render the DNS plan.
# No default in code; leave unset and the plan renders an explicit
# PRIMARY_INSTANCE_IP_UNSET placeholder instead of a wrong address.
# Verified 2026-11-13 value (do not rely on it staying assigned):
# SDS_PUBLIC_IPV4=129.146.111.166
SDS_PUBLIC_IPV4=

# Optional per-service timeout overrides (seconds, finite positive).
# Defaults: daedalus 45, openai 30, livekit 15, deepgram 30,
# elevenlabs 30, google 30 (plus a small region latency allowance).
# SDS_TIMEOUT_DAEDALUS=45
# SDS_TIMEOUT_LIVEKIT=15

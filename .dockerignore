# Build context allowlist: keys, databases, .env and local uploads stay excluded.
**
!requirements.txt
!requirements-server.txt
!core_platform/
!core_platform/*.py
!core_platform/*.py.pbd.json
!oci_free_resources.json
!oci_free_resources.json.pbd.json
!web/
!web/**
!backend/
!backend/Dockerfile
!backend/wsgi.py
!backend/wsgi.py.pbd.json
!backend/auth_session.py
!wsgi.py
!wsgi.py.pbd.json
!passenger_wsgi.py
!passenger_wsgi.py.pbd.json
!deploy/
!deploy/gunicorn.conf.py
!deploy/gunicorn.conf.py.pbd.json
!deploy/deployment.py
!deploy/deployment.py.pbd.json
!deploy/__init__.py
!deploy/__init__.py.pbd.json
!app/
!app/__init__.py
!app/__init__.py.pbd.json
!app/customer_app.py
!app/customer_app.py.pbd.json

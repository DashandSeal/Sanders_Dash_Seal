import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import sys

def compute_sha256(file_path: Path) -> str:
    hasher = hashlib.sha256()
    with open(file_path, 'rb') as f:
        while chunk := f.read(8192):
            hasher.update(chunk)
    return hasher.hexdigest()

def scan_metadata(root_path: Path) -> dict:
    inventory = []
    anomalies = []
    for file_path in root_path.rglob('*'):
        if file_path.is_file() and '.git' not in file_path.parts:
            rel_path = file_path.relative_to(root_path)
            if file_path.name == 'identity-metadata-report.json':
                continue
            try:
                file_hash = compute_sha256(file_path)
                stat_info = file_path.stat()
                inventory.append({
                    'path': str(rel_path),
                    'sha256': file_hash,
                    'size_bytes': stat_info.st_size
                })
            except Exception as e:
                anomalies.append({'path': str(rel_path), 'reason': str(e)})
    return {
        'platform': 'Sanders Dash & Seal',
        'schema': 1,
        'timestamp': datetime.now(timezone.utc).isoformat(),
        'scan_passed': len(anomalies) == 0,
        'inventory': sorted(inventory, key=lambda x: x['path'])
    }

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--root', default='.')
    parser.add_argument('--output', required=True)
    args = parser.parse_args()
    root_path = Path(args.root).resolve()
    output_path = Path(args.output).resolve()
    report = scan_metadata(root_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(json.dumps(report, indent=4))
    print("Metadata Scan Complete.")

if __name__ == '__main__':
    sys.exit(main())

# ------------------------------------------------------------------------------
# STAGE 1: HIGH-EFFICIENCY COMPILATION & BUILD ENGINE (BUILDER LAYER)
# ------------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Copy dependency specifications and install cleanly into user space
COPY requirements.txt requirements-server.txt ./
RUN pip install --no-cache-dir --user -r requirements-server.txt -r requirements.txt

# ------------------------------------------------------------------------------
# STAGE 2: AUTONOMOUS REAL-TIME SYNTHETIC AI AGENT RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runner

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/home/sanders/.local/bin:${PATH}"

# Configure system execution group permissions and file isolation boundaries
RUN groupadd --gid 10001 sanders && \
    useradd --uid 10001 --gid 10001 --no-create-home --home-dir /app sanders && \
    mkdir -p /app/data /var/log/sanders && \
    chown -R 10001:10001 /app /var/log/sanders

# Copy compiled dependency cache layers from intermediate build slice natively
COPY --from=builder --chown=10001:10001 /root/.local /home/sanders/.local
COPY --chown=10001:10001 core_platform/ /app/core_platform/
COPY --chown=10001:10001 deploy/ /app/deploy/
COPY --chown=10001:10001 wsgi.py wsgi.py.pbd.json ./

# Enforce secure non-root runtime context
USER 10001:10001

EXPOSE 8000

STOPSIGNAL SIGTERM

# CRITICAL SYSTEM ENTRYPOINT: Hand over control to our autonomous engine
CMD ["python3", "core_platform/agent_runtime.py"]

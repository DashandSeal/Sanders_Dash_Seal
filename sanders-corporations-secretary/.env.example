# Set privately on your own runtime, never commit real values.
SCS_API_TOKEN=REPLACE_WITH_LONG_RANDOM_VALUE
SCS_DB_PATH=./state/secretary.sqlite3
# Optional remote inference; false by default
SCS_ALLOW_REMOTE_INFERENCE=false
SCS_MODEL_API_URL=
SCS_MODEL_NAME=
SCS_MODEL_API_KEY=

# Optional continuous read-only GitHub monitoring (seconds, 0=off, >=180)
SCS_GITHUB_POLL_SECONDS=0